@model List<ResultAboutDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Ana Sayfa Hakkımızda Alanı</h4>

                        <p class="card-subtitle mb-4">
                            Ana sayfanın ve Hakkımızda sayfasının "Hakkımızda" alanında bulunan bilgileri aşağıdan düzenleyebilirsiniz.
                            Tema bütünlüğünün bozulmaması adına lütfen sadece 1 tane veri girişi yapınız.
                        </p>

                        @if (Model == null || Model.Count == 0)
                        {
                            <div class="d-flex justify-content-end mb-3">
                                <a href="/Admin/AdminAbout/CreateAbout" class="btn btn-primary">
                                    Yeni Hakkımızda Alanı Girişi
                                </a>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Görsel</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.title</td>
                                            <td>@item.description</td>
                                            <td>@item.imageUrl</td>

                                            <td>
                                                <a href="/Admin/AdminAbout/RemoveAbout/@item.aboutID"
                                                   class="btn btn-outline-danger">
                                                    Sil
                                                </a>
                                            </td>

                                            <td>
                                                <a href="/Admin/AdminAbout/UpdateAbout/@item.aboutID"
                                                   class="btn btn-outline-success">
                                                    Güncelle
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@model CreateBlogDto

@{
    ViewData["Title"] = "CreateBlog";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Yeni Blog Girişi</h4>

                        <p class="card-subtitle mb-4">
                            Yeni blog yazısına ait bilgileri aşağıdaki alanlara eksiksiz olarak giriniz.
                        </p>

                        <form method="post">

                            <div class="form-group mb-3">
                                <label>Blog Başlığı</label>

                                <input type="text"
                                       asp-for="title"
                                       class="form-control"
                                       placeholder="Blog başlığını giriniz" />
                            </div>

                            <div class="form-group mb-3">
                                <label>Yazar</label>
                                <select asp-for="authorID" asp-items="ViewBag.Authors" class="form-control">
                                    <option value="">Yazar Seçiniz</option>
                                </select>
                            </div>

                            <div class="form-group mb-3">
                                <label>Kategori</label>
                                <select asp-for="categoryID" asp-items="ViewBag.Categories" class="form-control">
                                    <option value="">Kategori Seçiniz</option>
                                </select>
                            </div>

                            <div class="form-group mb-3">
                                <label>Kapak Görseli URL</label>

                                <input type="text"
                                       asp-for="coverImageUrl"
                                       class="form-control"
                                       placeholder="Kapak görseli URL adresini giriniz" />
                            </div>

                            <div class="form-group mb-3">
                                <label>Blog Açıklaması</label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="6"
                                          placeholder="Blog açıklamasını giriniz"></textarea>
                            </div>

                            <div class="form-group mb-3">
                                <label>Oluşturulma Tarihi</label>

                                <input type="date"
                                       asp-for="createdDate"
                                       class="form-control" />
                            </div>

                            <div class="d-flex justify-content-end mt-3">

                                <button type="submit"
                                        class="btn btn-primary">
                                    Blogu Kaydet
                                </button>

                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
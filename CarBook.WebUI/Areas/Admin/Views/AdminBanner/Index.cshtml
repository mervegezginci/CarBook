@model List<ResultBannerDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-content">
    <div class="container-fluid">

        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">

                        <h4 class="card-title">Ana Sayfa Banner Alanı</h4>

                        <p class="card-subtitle mb-4">
                            Ana sayfanın banner alanında bulunan bilgileri aşağıdan düzenleyebilirsiniz.
                        </p>

                        @if (Model == null || Model.Count == 0)
                        {
                            <div class="d-flex justify-content-end mb-3">
                                <a href="/Admin/AdminBanner/CreateBanner" class="btn btn-primary">
                                    Yeni Banner Girişi
                                </a>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead>
                                    <tr>
                                        <th>Başlık</th>
                                        <th>Açıklama</th>
                                        <th>Video URL</th>
                                        <th>Video Açıklama</th>
                                        <th>Sil</th>
                                        <th>Güncelle</th>
                                        <th>Youtube'da Aç</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.Title</td>
                                            <td>@item.Description</td>
                                            <td>@item.VideoUrl</td>
                                            <td>@item.VideoDescription</td>

                                            <td>
                                                <a href="/Admin/AdminBanner/RemoveBanner/@item.BannerID"
                                                   class="btn btn-outline-danger">
                                                    Sil
                                                </a>
                                            </td>

                                            <td>
                                                <a href="/Admin/AdminBanner/UpdateBanner/@item.BannerID"
                                                   class="btn btn-outline-success">
                                                    Güncelle
                                                </a>
                                            </td>

                                            <td>
                                                <a href="@item.VideoUrl"
                                                   target="_blank"
                                                   class="btn btn-outline-dark">
                                                    Youtube'da Aç
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
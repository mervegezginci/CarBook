@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-xl-12">
                <div class="card">
                    <div class="card-body">
                        @if (ViewBag.v != null)
                        {
                            <h4 class="card-title">
                                Yorum Listesi - BlogID: @ViewBag.v
                            </h4>
                        }
                        else
                        {
                            <h4 class="card-title">
                                Tüm Yorumlar
                            </h4>
                        }
                        <p class="card-subtitle mb-4">
                            Bloglarla ilgili o bloga yapılmış olan yorum listesini bu sayfadan görebilirsiniz. İlgili yorumları kaldırabilir ya da tekrar aktif hale getirebilirsiniz. Bunun için yorumların altında yer alan butonları kullanabilirsiniz.
                        </p>
                        @foreach (var item in Model)
                        {
                            count++;

                            <div class="col-md-12">
                                <div class="card">
                                    <h5 class="card-header">
                                        Yorum - @count
                                    </h5>

                                    <div class="card-body">

                                        <h4 class="card-title">
                                            @item.Name
                                        </h4>

                                        <p class="mb-2">
                                            <strong>Blog:</strong> @item.BlogTitle
                                        </p>

                                        <p class="card-text">
                                            @item.Description
                                        </p>

                                        <a href="/Blog/BlogDetail/@item.BlogID"
                                           target="_blank"
                                           class="btn btn-outline-dark">
                                            Blogu Aç
                                        </a>

                                        <a href="#"
                                           class="btn btn-outline-danger">
                                            Yorumu Kaldır
                                        </a>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@model List<ResultCommentDto>

<div class="pt-5 mt-5">

    <h3 class="mb-5">@Model.Count Yorum</h3>

    <ul class="comment-list">

        @foreach (var item in Model)
        {
            <li class="comment">

                <div class="vcard bio">
                    <img src="@item.ImageUrl"
                         alt="@item.Name">
                </div>

                <div class="comment-body">

                    <h3>@item.Name</h3>

                    <div class="meta">
                        @item.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                    </div>

                    <p>
                        @item.Description
                    </p>

                </div>

            </li>
        }

    </ul>

</div>
@{
    ViewData["Title"] = "Index";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_HeadUILayoutComponentPartial")

<body>


    @await Component.InvokeAsync("_NavbarUILayoutComponentPartial")

    @await Component.InvokeAsync("_DefaultCoverUILayoutComponentPartial")

    <section class="ftco-section ftco-no-pt bg-light">
        <div class="container">
            <div class="row no-gutters">

                <div class="col-md-12 featured-top">
                    <div class="row no-gutters">

                        <!-- Araç Kiralama Formu -->
                        <div class="col-md-4 d-flex align-items-center">

                            <form action="#" class="request-form ftco-animate bg-primary">

                                <h2>Yolculuğunuzu Planlayın</h2>

                                <div class="form-group">
                                    <label class="label">Alış Konumu</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Şehir, havalimanı, istasyon vb.">
                                </div>

                                <div class="form-group">
                                    <label class="label">Teslim Konumu</label>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Şehir, havalimanı, istasyon vb.">
                                </div>

                                <div class="d-flex">

                                    <div class="form-group mr-2">
                                        <label class="label">Alış Tarihi</label>

                                        <input type="text"
                                               class="form-control"
                                               id="book_pick_date"
                                               placeholder="Tarih">
                                    </div>

                                    <div class="form-group ml-2">
                                        <label class="label">Teslim Tarihi</label>

                                        <input type="text"
                                               class="form-control"
                                               id="book_off_date"
                                               placeholder="Tarih">
                                    </div>

                                </div>

                                <div class="form-group">
                                    <label class="label">Alış Saati</label>

                                    <input type="text"
                                           class="form-control"
                                           id="time_pick"
                                           placeholder="Saat">
                                </div>

                                <div class="form-group">

                                    <input type="submit"
                                           value="Uygun Araçları Bul"
                                           class="btn btn-secondary py-3 px-4">

                                </div>

                            </form>

                        </div>


                        <!-- Nasıl Çalışır Alanı -->
                        <div class="col-md-8 d-flex align-items-center">

                            <div class="services-wrap rounded-right w-100">

                                <h3 class="heading-section mb-4">
                                    Size En Uygun Aracı Kolayca Kiralayın
                                </h3>

                                <div class="row d-flex mb-4">

                                    <!-- 1 -->
                                    <div class="col-md-4 d-flex align-self-stretch ftco-animate">

                                        <div class="services w-100 text-center">

                                            <div class="icon d-flex align-items-center justify-content-center">
                                                <span class="flaticon-route"></span>
                                            </div>

                                            <div class="text w-100">
                                                <h3 class="heading mb-2">
                                                    Alış Konumunuzu Belirleyin
                                                </h3>
                                            </div>

                                        </div>

                                    </div>


                                    <!-- 2 -->
                                    <div class="col-md-4 d-flex align-self-stretch ftco-animate">

                                        <div class="services w-100 text-center">

                                            <div class="icon d-flex align-items-center justify-content-center">
                                                <span class="flaticon-handshake"></span>
                                            </div>

                                            <div class="text w-100">
                                                <h3 class="heading mb-2">
                                                    Size Uygun Aracı Seçin
                                                </h3>
                                            </div>

                                        </div>

                                    </div>


                                    <!-- 3 -->
                                    <div class="col-md-4 d-flex align-self-stretch ftco-animate">

                                        <div class="services w-100 text-center">

                                            <div class="icon d-flex align-items-center justify-content-center">
                                                <span class="flaticon-rent"></span>
                                            </div>

                                            <div class="text w-100">
                                                <h3 class="heading mb-2">
                                                    Rezervasyonunuzu Oluşturun
                                                </h3>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                                <p>
                                    <a href="/Car/Index"
                                       class="btn btn-primary py-3 px-4">
                                        Araçlarımızı İnceleyin
                                    </a>
                                </p>

                            </div>

                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

    @await Component.InvokeAsync("_DefaultLast5CarsWithBrandsComponentPartial")

    @await Component.InvokeAsync("_AboutUsComponentPartial")

    @await Component.InvokeAsync("_ServiceComponentPartial")

    @await Component.InvokeAsync("_BecomeADriverComponentPartial")

    @await Component.InvokeAsync("_TestimonialComponentPartial")

    @await Component.InvokeAsync("_GetLast3BlogsWithAuthorListComponentPartial")

    @await Component.InvokeAsync("_DefaultStatisticsComponentPartial")

    @await Component.InvokeAsync("_FooterUILayoutComponentPartial")

    @await Component.InvokeAsync("_ScriptUILayoutComponentPartial")

</body>
</html>
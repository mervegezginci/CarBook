@using CarBook.Dto.FooterAddressDtos
@model ResultFooterAddressDto

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'success',
                title: 'Mesajınız Gönderildi!',
                text: '@Html.Raw(TempData["SuccessMessage"])',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true
            });
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                icon: 'error',
                title: 'Gönderilemedi!',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                confirmButtonText: 'Tamam'
            });
        });
    </script>
}

<section class="ftco-section contact-section">
    <div class="container">

        <div class="row d-flex mb-5 contact-info">

            <div class="col-md-4">
                <div class="row mb-5">

                    <div class="col-md-12">
                        <div class="border w-100 p-4 rounded mb-2 d-flex">
                            <div class="icon mr-3">
                                <span class="icon-map-o"></span>
                            </div>

                            <p>
                                <span>Adres:</span>
                                @Model.Address
                            </p>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="border w-100 p-4 rounded mb-2 d-flex">
                            <div class="icon mr-3">
                                <span class="icon-mobile-phone"></span>
                            </div>

                            <p>
                                <span>Telefon:</span>
                                <a href="tel:@Model.Phone">
                                    @Model.Phone
                                </a>
                            </p>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="border w-100 p-4 rounded mb-2 d-flex">
                            <div class="icon mr-3">
                                <span class="icon-envelope-o"></span>
                            </div>

                            <p>
                                <span>E-posta:</span>
                                <a href="mailto:@Model.Email">
                                    @Model.Email
                                </a>
                            </p>
                        </div>
                    </div>

                </div>
            </div>


            <div class="col-md-8 block-9 mb-md-5">

                <form asp-controller="Contact"
                      asp-action="Index"
                      method="post"
                      class="bg-light p-5 contact-form">

                    <div class="form-group">
                        <input type="text"
                               name="Name"
                               class="form-control"
                               placeholder="Adınız Soyadınız"
                               required>
                    </div>

                    <div class="form-group">
                        <input type="email"
                               name="Email"
                               class="form-control"
                               placeholder="E-posta Adresiniz"
                               required>
                    </div>

                    <div class="form-group">
                        <input type="text"
                               name="Subject"
                               class="form-control"
                               placeholder="Konu"
                               required>
                    </div>

                    <div class="form-group">
                        <textarea name="Message"
                                  cols="30"
                                  rows="7"
                                  class="form-control"
                                  placeholder="Mesajınız"
                                  required></textarea>
                    </div>

                    <div class="form-group">
                        <input type="submit"
                               value="Mesaj Gönder"
                               class="btn btn-primary py-3 px-5">
                    </div>

                </form>

            </div>

        </div>


        <!-- Harita -->
        <div class="row justify-content-center">
            <div class="col-md-12">

                <div class="map-area">

                    <iframe src="https://www.google.com/maps?q=@Uri.EscapeDataString(Model.Address)&output=embed"
                            width="100%"
                            height="450"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy">
                    </iframe>

                </div>

            </div>
        </div>

    </div>
</section>